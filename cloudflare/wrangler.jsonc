{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prospeccao-starlink",
  "main": "src/index.ts",
  "account_id": "653bb4dc95bf8c3d4845f9aca64201ba",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Gatilhos agendados (America/Sao_Paulo = UTC-3 fixo desde 2019):
  //  - "0 3 * * *"  -> 00:00 BRT: BACKUP COMPLETO diario e autonomo (runBackup).
  //  - "0 9 * * *"  -> 06:00 BRT: varredura rotativa da prospeccao (runCron).
  "triggers": {
    "crons": ["0 3 * * *", "0 9 * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Worker roda ANTES dos assets para aplicar o login tambem nas paginas estaticas.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prospeccao-starlink",
      "database_id": "15f81b0c-03fb-4e1d-96a5-2d934ff306d8",
      "migrations_dir": "migrations"
    }
  ]
}
